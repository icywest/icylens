---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BackendStatus } from '../components/BackendStatus';
import { FileAnalysisApp } from '../components/FileAnalysisApp';
---

<BaseLayout>
  <header class="site-header">
    <div class="site-shell site-header__inner">
      <a href="#main-content" class="brand" aria-label="iCYLENS home">
        <span>
          <strong>iCYLENS</strong>
          <small>File Analysis Lab</small>
        </span>
      </a>
      <BackendStatus client:load />
    </div>
  </header>

  <main id="main-content" class="site-shell main-workbench">
    <section class="page-heading" aria-labelledby="page-title">
      <h1 id="page-title">File analysis</h1>
      <p>
        Select a file to inspect its identity and bounded static properties.
        Uploaded content is not executed.
      </p>
    </section>

    <FileAnalysisApp client:load />
  </main>

  <footer class="site-shell site-footer">
    <span>Academic demonstration</span>
    <span aria-hidden="true">·</span>
    <span>No malware verdicts or threat feeds</span>
  </footer>
</BaseLayout>
